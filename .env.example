# Base de datos PostgreSQL
# Host: en tu PC (ETL/API fuera de Docker) usa `localhost`. En Compose el servicio inyecta `db`;
# el ETL detecta ejecución local y reemplaza `db` por 127.0.0.1 si hace falta.
POSTGRES_HOST=localhost
POSTGRES_USER=aedmi_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=aedmi_db
POSTGRES_PORT=5432

# API
API_PORT=8080
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRE_HOURS=8

# Autenticación de la app
ADMIN_USER=PhiQus
ADMIN_PASSWORD=change_me_in_production

# Groq API para análisis IA
GROQ_API_KEY=your_groq_api_key_here

# Gamma (exportación de presentación desde la cola del dashboard; opcional)
# GAMMA_API_KEY=
# THEME_ID=                    # tema corporativo (obligatorio para identidad visual; la API lo envía a Gamma)

# PPTX corporativo (opcional). Ruta a un .pptx con estructura §12 del SPEC_DRIVEN_CONTRACT.md.
# Listo en el repo: api/assets/plantilla-aedmi-export.pptx (ver api/assets/README.md).
# Ejemplos:
# - CWD = carpeta api/: PPTX_TEMPLATE_PATH=assets/plantilla-aedmi-export.pptx
# - Docker (volumen ./api:/app): PPTX_TEMPLATE_PATH=/app/assets/plantilla-aedmi-export.pptx
# Si se omite o el archivo no existe: generación legacy. Ver README (exportación PowerPoint).
# PPTX_TEMPLATE_PATH=

# Frontend
FRONTEND_PORT=3000
API_URL=http://localhost:8080

# CORS API (separado por comas)
CORS_ORIGINS=http://localhost:3000

# ETL catálogo pueblos mágicos (opcional)
# CSV remoto con columnas recomendadas: clave,nombre,entidad,municipio,lat,lng,fuente
PUEBLOS_MAGICOS_CSV_URL=

# Módulo mapa (resiliencia / caché; opcionales, tienen default en la API)
MAPA_PROVIDER_TIMEOUT_MS=4000
MAPA_MAX_RETRIES=2
MAPA_CIRCUIT_BREAKER_FAILURES=5
MAPA_COOLDOWN_SECONDS=120
MAPA_FALLBACK_MAX_AGE_SECONDS=86400
MAPA_QUERY_CACHE_TTL_SECONDS=300

# Producción (solo para .env.prod)
# API_URL=https://tu-dominio.com
