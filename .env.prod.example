# Base de datos PostgreSQL
POSTGRES_USER=aedmi_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aedmi_db
POSTGRES_PORT=5432

# API
API_PORT=8080
JWT_SECRET=change_me_long_random_secret
JWT_EXPIRE_HOURS=8

# Autenticación app
ADMIN_USER=PhiQus
ADMIN_PASSWORD=change_me_strong_password

# IA
GROQ_API_KEY=your_groq_api_key_here

# PPTX corporativo (opcional). Ejemplo VPS con Plantilla del repo montada en /app/assets
# PPTX_TEMPLATE_PATH=/app/assets/plantilla-aedmi-export.pptx

# Frontend público
FRONTEND_PORT=3000
# Si expones por puertos (sin Nginx): http://TU_IP:8080
# Si expones detrás de Nginx: https://tu-dominio.com/api
API_URL=https://tu-dominio.com/api

# CORS en API:
# - Si expones por puertos: http://TU_IP:3000
# - Si expones por dominio: https://tu-dominio.com
# Nota: si no defines CORS_ORIGINS, el API permite todos los orígenes (sin credentials).
CORS_ORIGINS=https://tu-dominio.com

# ETL (producción): por defecto bootstrap masivo al arrancar (ETL_RUN_ON_START=1 vía docker-compose).
# Tras restaurar db/vps-snapshot/ en el VPS, define ETL_RUN_ON_START=0 para no re-ejecutar todo el ETL.
# ETL_RUN_ON_START=0

# ETL catálogo pueblos mágicos (opcional)
PUEBLOS_MAGICOS_CSV_URL=
